# Variable NAMES only. Never commit real values (.env is git ignored).

DATABASE_URL=

# Contact form email over SMTP (Gmail App Password, spaces removed).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT_EMAIL=

# Contact form email over the Resend HTTPS API; when set it is used instead of SMTP (needed on Cloudflare Workers).
RESEND_API_KEY=
# Optional sender, defaults to "Hot Air Balloon Website <onboarding@resend.dev>" until a domain is verified in Resend.
RESEND_FROM_EMAIL=

# Live Google reviews (optional).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
